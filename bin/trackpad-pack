#!/usr/bin/env bash
# Apply xuanping.trackpad Hyprland features. Missing state means all on.

set -euo pipefail

PLUGIN_ID="xuanping.trackpad"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/${PLUGIN_ID}"
STATE_JSON="$STATE_DIR/features.json"
LEGACY_STATE="$STATE_DIR/enabled"
HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
PACK_LUA="$HYPR_DIR/xuanping-trackpad.lua"
HYPRLAND_LUA="$HYPR_DIR/hyprland.lua"
MARKER_BEGIN="-- BEGIN xuanping.trackpad"
MARKER_END="-- END xuanping.trackpad"
REQUIRE_LINE='pcall(require, "hypr.xuanping-trackpad")'
MACOS_ACCEL="custom 0.5 0.0 0.05 0.11 0.195 0.32 0.494 0.735 1.06 1.488 2.05 2.775 3.69 4.83 6.235 7.95 9.994 12.4 15.2 17.1 18.05 19.0 19.95"

usage() {
  cat <<EOF
Usage: trackpad-pack <command>

  apply                         Write Hyprland config from saved state (default: all on)
  status                        Print JSON
  set <drag3fg|swipe4|macosAccel> <on|off>
  toggle <drag3fg|swipe4|macosAccel>
  battery                       Print HID trackpad battery JSON
  install-hidraw [--if-needed]  udev rule (uaccess) so Bluetooth reconnects can read report 0x90
EOF
}

ensure_require() {
  mkdir -p "$HYPR_DIR"
  python3 - "$HYPRLAND_LUA" "$MARKER_BEGIN" "$REQUIRE_LINE" "$MARKER_END" <<'PY'
import pathlib, sys

path = pathlib.Path(sys.argv[1])
begin, require_line, end = sys.argv[2], sys.argv[3], sys.argv[4]
block = f"{begin}\n{require_line}\n{end}\n"
text = path.read_text() if path.exists() else ""
if begin in text:
    raise SystemExit(0)
needle = 'require("hypr.input")'
idx = text.find(needle)
if idx >= 0:
    nl = text.find("\n", idx)
    insert_at = nl + 1 if nl >= 0 else len(text)
    text = text[:insert_at] + "\n" + block + "\n" + text[insert_at:]
else:
    text = text.rstrip() + ("\n\n" if text.strip() else "") + block + "\n"
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(text)
PY
}

reload_hypr() {
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null
  fi
}

osd() {
  local msg=$1
  if command -v omarchy-osd >/dev/null 2>&1; then
    omarchy-osd -i touchpad -m "$msg" >/dev/null 2>&1 || true
  fi
}

print_battery() {
  python3 - "$STATE_DIR/battery-cache.json" <<'PY'
import fcntl, json, os, pathlib, subprocess, sys, time

CACHE = pathlib.Path(sys.argv[1])
now = time.time()

IOC_READ, IOC_WRITE = 2, 1
IOC_NRSHIFT, IOC_TYPESHIFT, IOC_SIZESHIFT, IOC_DIRSHIFT = 0, 8, 16, 30

def ioc(direction, type_, nr, size):
    return ((direction << IOC_DIRSHIFT) | (ord(type_) << IOC_TYPESHIFT)
            | (nr << IOC_NRSHIFT) | (size << IOC_SIZESHIFT))

def load_cache():
    if not CACHE.exists():
        return None
    try:
        raw = CACHE.read_text()
        data, _ = json.JSONDecoder().raw_decode(raw)
    except (OSError, json.JSONDecodeError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    pct = data.get("percentage")
    if not isinstance(pct, int) or pct <= 0:
        return None
    return data

def save_cache(rec):
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "percentage": rec["percentage"],
        "status": rec.get("status", "Discharging"),
        "model": rec.get("model", ""),
        "savedAt": now,
    }
    tmp = CACHE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(payload) + "\n")
    tmp.replace(CACHE)

def read_uevent(path):
    data = {}
    try:
        for line in path.read_text().splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                data[key] = value
    except OSError:
        return None
    return data

# Kernel HID_ID is bus:vendor:product as %04X:%08X:%08X.
# USB Apple 05ac / BT Apple 004c; trackpad PIDs 0265, 0324 (USB-C), 030e (1st gen).
APPLE_TRACKPAD_VP = frozenset({
    (0x05AC, 0x0265), (0x05AC, 0x0324), (0x05AC, 0x030E),
    (0x004C, 0x0265), (0x004C, 0x0324), (0x004C, 0x030E),
})

def parse_hid_id(hid_id):
    parts = (hid_id or "").strip().split(":")
    if len(parts) != 3:
        return None
    try:
        return tuple(int(part, 16) for part in parts)
    except ValueError:
        return None

def is_apple_trackpad_id(hid_id):
    parsed = parse_hid_id(hid_id)
    if not parsed:
        return False
    _bus, vendor, product = parsed
    return (vendor, product) in APPLE_TRACKPAD_VP

def text_has_trackpad(blob):
    lowered = (blob or "").lower()
    return "trackpad" in lowered or "touchpad" in lowered

def hid_info_from(path):
    cur = pathlib.Path(path)
    seen = set()
    for _ in range(8):
        try:
            cur = cur.resolve()
        except OSError:
            return {}
        key = str(cur)
        if key in seen:
            break
        seen.add(key)
        data = read_uevent(cur / "uevent") or {}
        if data.get("HID_ID") or data.get("HID_NAME"):
            return data
        nxt = cur / "device"
        if nxt.exists():
            cur = nxt
            continue
        parent = cur.parent
        if parent == cur:
            break
        cur = parent
    return {}

def is_trackpad_hid(name, hid_id):
    if is_apple_trackpad_id(hid_id):
        return True
    return text_has_trackpad(name)

def sysfs_battery():
    root = pathlib.Path("/sys/class/power_supply")
    best, best_score = None, -1
    if not root.exists():
        return None
    for path in sorted(root.iterdir()):
        data = read_uevent(path / "uevent")
        if not data or data.get("POWER_SUPPLY_TYPE") != "Battery":
            continue
        if data.get("POWER_SUPPLY_SCOPE") != "Device":
            continue
        model = data.get("POWER_SUPPLY_MODEL_NAME", "")
        name = data.get("POWER_SUPPLY_NAME", "")
        hid = hid_info_from(path)
        hid_name = hid.get("HID_NAME", "")
        hid_id = hid.get("HID_ID", "")
        blob = f"{model} {name} {hid_name}"
        if is_apple_trackpad_id(hid_id):
            score = 3
        elif text_has_trackpad(blob):
            score = 2
        else:
            continue
        try:
            capacity = int(data.get("POWER_SUPPLY_CAPACITY", "-1"))
        except ValueError:
            capacity = -1
        rec = {
            "present": data.get("POWER_SUPPLY_PRESENT", "1") == "1",
            "percentage": capacity,
            "status": data.get("POWER_SUPPLY_STATUS", "Unknown"),
            "model": model or hid_name or name,
            "path": str(path),
            "source": "sysfs",
            "stale": False,
        }
        if score > best_score:
            best, best_score = rec, score
    return best

def hidraw_devices():
    sysfs = pathlib.Path("/sys/class/hidraw")
    if not sysfs.exists():
        return []
    found = []
    for entry in sorted(sysfs.iterdir()):
        data = read_uevent(entry / "device" / "uevent") or {}
        name = data.get("HID_NAME", "")
        hid_id = data.get("HID_ID", "")
        if not is_trackpad_hid(name, hid_id):
            continue
        found.append((f"/dev/{entry.name}", name or "Magic Trackpad"))
    return found

def hypr_trackpad_present():
    try:
        out = subprocess.check_output(
            ["hyprctl", "devices", "-j"],
            text=True,
            timeout=1,
            stderr=subprocess.DEVNULL,
        )
        data = json.loads(out)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, ValueError):
        return False
    for group in ("mice", "touchpads"):
        for dev in data.get(group) or []:
            name = str(dev.get("name") or "").lower()
            if "magic-trackpad" in name or "trackpad" in name:
                return True
    return False

def hidraw_battery():
    # Input report 0x90: [id, status_flags, capacity]. Bit 1 of status = charging.
    for dev, name in hidraw_devices():
        try:
            fd = os.open(dev, os.O_RDWR)
        except OSError:
            continue
        try:
            for size in (3, 4, 8):
                buf = bytearray(size)
                buf[0] = 0x90
                try:
                    fcntl.ioctl(fd, ioc(IOC_READ | IOC_WRITE, "H", 0x0A, size), buf)
                except OSError:
                    try:
                        fcntl.ioctl(fd, ioc(IOC_READ | IOC_WRITE, "H", 0x07, size), buf)
                    except OSError:
                        continue
                if buf[0] not in (0x90, 0) and size > 1:
                    continue
                capacity = buf[2] if size > 2 else -1
                if not (0 < capacity <= 100):
                    continue
                charging = bool(buf[1] & 0x02) if size > 1 else False
                return {
                    "present": True,
                    "percentage": int(capacity),
                    "status": "Charging" if charging else "Discharging",
                    "model": name,
                    "path": dev,
                    "source": "hidraw",
                    "stale": False,
                }
        finally:
            os.close(fd)
    return None

sys_rec = sysfs_battery()
cache = load_cache()
chosen = {
    "present": False,
    "percentage": -1,
    "status": "Disconnected",
    "model": "",
    "source": "none",
    "stale": False,
}

def cache_rec(model="", path=""):
    if not cache:
        return None
    return {
        "present": True,
        "percentage": cache["percentage"],
        "status": cache.get("status", "Discharging"),
        "model": model or cache.get("model", ""),
        "path": path,
        "source": "cache",
        "stale": True,
    }

hid_rec = hidraw_battery() if (not sys_rec or sys_rec.get("percentage", -1) <= 0) else None
connected = bool(sys_rec) or bool(hidraw_devices()) or hypr_trackpad_present()

if hid_rec:
    chosen = hid_rec
elif sys_rec and sys_rec.get("percentage", -1) > 0:
    chosen = sys_rec
elif sys_rec and sys_rec.get("present"):
    # Kernel 0% after a Bluetooth reset can last minutes. Keep the last
    # good reading as stale so the bar icon stays up.
    chosen = cache_rec(sys_rec.get("model", ""), sys_rec.get("path", "")) or {
        "present": True,
        "percentage": -1,
        "status": sys_rec.get("status", "Unknown"),
        "model": sys_rec.get("model", ""),
        "path": sys_rec.get("path", ""),
        "source": "sysfs",
        "stale": False,
    }
elif connected:
    chosen = cache_rec() or {
        "present": True,
        "percentage": -1,
        "status": "Unknown",
        "model": (cache or {}).get("model", ""),
        "source": "hypr",
        "stale": False,
    }
elif cache and (now - float(cache.get("savedAt", 0))) < 180:
    # power_supply/hidraw can vanish for a few seconds during a BT rebind.
    chosen = cache_rec()

if chosen.get("present") and chosen.get("percentage", -1) > 0 and not chosen.get("stale"):
    save_cache(chosen)
print(json.dumps(chosen))
PY
}

install_hidraw() {
  local rule_src dest old if_needed=0
  rule_src="$(cd "$(dirname "$0")/.." && pwd)/udev/70-xuanping-trackpad-hidraw.rules"
  dest=/etc/udev/rules.d/70-xuanping-trackpad-hidraw.rules
  old=/etc/udev/rules.d/99-xuanping-trackpad-hidraw.rules
  [[ ${1:-} == --if-needed ]] && if_needed=1
  [[ -f $rule_src ]] || { echo "missing udev rule: $rule_src" >&2; return 1; }
  if [[ $if_needed -eq 1 && -f $dest && ! -e $old ]] && cmp -s "$rule_src" "$dest"; then
    return 0
  fi
  pkexec /usr/bin/bash -c 'set -euo pipefail
src=$1 dest=$2 old=$3
/usr/bin/install -m 644 "$src" "$dest"
/usr/bin/rm -f "$old"
/usr/bin/udevadm control --reload-rules
/usr/bin/udevadm trigger --action=add --subsystem-match=hidraw
' bash "$rule_src" "$dest" "$old"
  echo "installed $dest"
}

FEATURES="drag3fg swipe4 macosAccel"

run_features() {
  python3 - "$STATE_JSON" "$LEGACY_STATE" "$PACK_LUA" "$HYPRLAND_LUA" "$MACOS_ACCEL" "$MARKER_BEGIN" "$@" <<'PY'
import json, os, pathlib, re, subprocess, sys

KEYS = ("drag3fg", "swipe4", "macosAccel")
LABELS = {
    "drag3fg": "Three-finger drag",
    "swipe4": "Four-finger swipe",
    "macosAccel": "macOS pointer curve",
}
FALLBACK_DEVICES = (
    "apple-inc.-magic-trackpad",
    "apple-inc.-magic-trackpad-1",
)

state_path = pathlib.Path(sys.argv[1])
legacy_path = pathlib.Path(sys.argv[2])
pack_path = pathlib.Path(sys.argv[3])
hypr_path = pathlib.Path(sys.argv[4])
accel = sys.argv[5]
marker = sys.argv[6]
argv = sys.argv[7:]


def default_state():
    return {key: True for key in KEYS}


def load_state():
    if state_path.exists():
        try:
            data = json.loads(state_path.read_text())
        except json.JSONDecodeError:
            data = {}
        out = default_state()
        for key in KEYS:
            if key in data:
                out[key] = bool(data[key])
        return out
    if legacy_path.exists():
        raw = legacy_path.read_text().strip()
        value = raw != "0"
        return {key: value for key in KEYS}
    return default_state()


def save_state(state):
    state_path.parent.mkdir(parents=True, exist_ok=True)
    payload = {key: bool(state[key]) for key in KEYS}
    state_path.write_text(json.dumps(payload, indent=2) + "\n")
    return payload


SAFE_DEVICE_NAME = re.compile(r"^[a-z0-9._-]+$")


def hypr_internal_name(name):
    # Match Hyprland deviceNameToInternalString: space/newline/comma -> '-', lower.
    return "".join("-" if ch in " \n," else ch.lower() for ch in str(name))


def lua_quote(name):
    escaped = (
        name.replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", "\\n")
        .replace("\r", "\\r")
    )
    return f'"{escaped}"'


def classify_trackpad_name(name):
    if "magic-trackpad" in name or "magictrackpad" in name:
        return 2
    if "trackpad" in name or "touchpad" in name:
        return 1
    return 0


def discover_devices():
    preferred, weak = [], []
    try:
        raw = subprocess.check_output(["hyprctl", "devices", "-j"], text=True, timeout=2)
        data = json.loads(raw)
        for mouse in data.get("mice") or []:
            name = hypr_internal_name(mouse.get("name") or "")
            if not SAFE_DEVICE_NAME.fullmatch(name):
                continue
            rank = classify_trackpad_name(name)
            if rank >= 2:
                preferred.append(name)
            elif rank == 1:
                weak.append(name)
    except Exception:
        pass
    names = set(FALLBACK_DEVICES)
    if preferred:
        names.update(preferred)
    else:
        names.update(weak)
    return sorted(name for name in names if SAFE_DEVICE_NAME.fullmatch(name))


def render_lua(state):
    # Additive overlays only. Disabled features are omitted, never written as
    # 0/false, so a reload restores whatever earlier files (Omarchy defaults,
    # input.lua, other plugins) already set. No global hl.config({ input }).
    header = """-- Generated by xuanping.trackpad. Additive overlays only; do not edit.
-- Disabled switches omit their keys instead of writing 0/false.
"""
    if not any(state[key] for key in KEYS):
        return header + "return\n"

    devices = discover_devices()
    quoted = ", ".join(lua_quote(name) for name in devices)
    parts = [header]
    if state["macosAccel"]:
        parts.append(f'local macos_accel =\n  "{accel}"\n\n')

    fields = []
    if state["macosAccel"]:
        fields.append("    sensitivity = 0,")
        fields.append("    accel_profile = macos_accel,")
    if state["drag3fg"]:
        fields.append("    drag_3fg = 1,")
    if fields:
        parts.append(
            "for _, name in ipairs({ %s }) do\n  hl.device({\n    name = name,\n%s\n  })\nend\n"
            % (quoted, "\n".join(fields))
        )

    if state["swipe4"]:
        parts.append(
            'hl.gesture({ fingers = 4, direction = "horizontal", action = "scroll_move" })\n'
        )
    return "".join(parts)


def applied_flags(text):
    return {
        "drag3fg": "drag_3fg = 1" in text,
        "swipe4": "scroll_move" in text,
        "macosAccel": "macos_accel" in text and "accel_profile = macos_accel" in text,
    }


def apply(state):
    desired = render_lua(state)
    pack_path.parent.mkdir(parents=True, exist_ok=True)
    current = pack_path.read_text() if pack_path.exists() else None
    changed = current != desired
    if changed:
        pack_path.write_text(desired)
    require = hypr_path.exists() and marker in hypr_path.read_text()
    return changed, require, desired


def parse_bool(value):
    text = str(value).strip().lower()
    if text in ("1", "on", "true", "yes"):
        return True
    if text in ("0", "off", "false", "no"):
        return False
    raise SystemExit(f"expected on/off, got {value!r}")


def status_payload(state, require_present):
    text = pack_path.read_text() if pack_path.exists() else ""
    flags = applied_flags(text)
    return {
        "drag3fg": state["drag3fg"],
        "swipe4": state["swipe4"],
        "macosAccel": state["macosAccel"],
        "enabled": any(state[key] for key in KEYS),
        "applied": flags,
        "requirePresent": require_present,
        "stateFile": str(state_path),
        "packLua": str(pack_path),
    }


cmd = argv[0] if argv else "status"
state = load_state()
osd_msg = None
mutate = True

if cmd == "set":
    if len(argv) < 3:
        raise SystemExit("usage: trackpad-pack set <drag3fg|swipe4|macosAccel> <on|off>")
    key, value = argv[1], argv[2]
    if key not in KEYS:
        raise SystemExit(f"unknown feature {key}")
    state[key] = parse_bool(value)
    osd_msg = f"{LABELS[key]} {'on' if state[key] else 'off'}"
elif cmd == "toggle":
    if len(argv) < 2:
        raise SystemExit("usage: trackpad-pack toggle <drag3fg|swipe4|macosAccel>")
    key = argv[1]
    if key not in KEYS:
        raise SystemExit(f"unknown feature {key}")
    state[key] = not state[key]
    osd_msg = f"{LABELS[key]} {'on' if state[key] else 'off'}"
elif cmd == "enable":
    state = default_state()
    osd_msg = "Trackpad feel on"
elif cmd == "disable":
    state = {key: False for key in KEYS}
    osd_msg = "Trackpad feel off"
elif cmd == "apply":
    pass
elif cmd == "status":
    mutate = False
else:
    raise SystemExit(f"unknown command {cmd}")

require_present = hypr_path.exists() and marker in hypr_path.read_text()
changed = False
if mutate:
    state = save_state(state)
    changed, require_present, _desired = apply(state)
print(json.dumps(status_payload(state, require_present)))
pathlib.Path(str(state_path) + ".meta").write_text(
    json.dumps({"changed": changed, "osd": osd_msg or ""}) + "\n"
)
PY
}

apply_side_effects() {
  local meta="$STATE_JSON.meta"
  local changed=0
  local msg=""
  if [[ -f $meta ]]; then
    changed=$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1])).get("changed", False)))' "$meta")
    msg=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("osd") or "")' "$meta")
    rm -f "$meta"
  fi
  if ! grep -Fq -- "$MARKER_BEGIN" "$HYPRLAND_LUA" 2>/dev/null; then
    ensure_require
    changed=1
  fi
  if (( changed )); then
    reload_hypr
  fi
  if [[ -n $msg ]]; then
    osd "$msg"
  fi
}

cmd="${1:-}"
case "$cmd" in
  -h | --help | help)
    usage
    ;;
  apply | status | enable | disable)
    run_features "$cmd"
    apply_side_effects
    ;;
  set)
    run_features set "${2:-}" "${3:-}"
    apply_side_effects
    ;;
  toggle)
    run_features toggle "${2:-}"
    apply_side_effects
    ;;
  battery)
    print_battery
    ;;
  install-hidraw)
    install_hidraw "${2:-}"
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
