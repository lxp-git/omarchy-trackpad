#!/usr/bin/bash
# User-level dispatcher. The Python helper refuses root. The udev rule
# bytes are a literal in this file so sudo never reads the plugin checkout.

set -euo pipefail

PLUGIN_ID="xuanping.trackpad"
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$ROOT/lib/trackpad.py"
PYTHON=/usr/bin/python3
TIMEOUT=/usr/bin/timeout
HEAD=/usr/bin/head
SUDO=/usr/bin/sudo
OSD=/usr/bin/omarchy-osd
UDEV_DEST=/etc/udev/rules.d/70-xuanping-trackpad-hidraw.rules
MAX_OUT=65536

# Keep this literal identical to udev/70-xuanping-trackpad-hidraw.rules.
# Root installs these bytes; it does not copy from the plugin directory.
UDEV_RULE=$(cat << 'EOF'
# Magic Trackpad hidraw: seated user via logind uaccess.
# Needed to read HID battery report 0x90 after a Bluetooth reconnect
# (kernel power_supply often stays at 0%). Match the parent magicmouse
# HID driver and Apple trackpad IDs only (USB 05ac:0265 / 05ac:0324 /
# 05ac:030e, BT 004c:0265 / 004c:0324 / 004c:030e). Do not match Magic Mouse
# or a device that only has "Trackpad" in a self-reported name string.
#
# Filename must sort before 73-seat-late.rules so TAG+="uaccess" is applied.
# Bluetooth hidraw sits under /devices/virtual/misc/uhid and has no seat;
# ENV{ID_SEAT}="seat0" is what makes logind write the ACL.
ACTION!="remove", SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", KERNELS=="0003:05AC:0265.*", MODE="0660", TAG+="uaccess", ENV{ID_SEAT}="seat0"
ACTION!="remove", SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", KERNELS=="0003:05AC:030E.*", MODE="0660", TAG+="uaccess", ENV{ID_SEAT}="seat0"
ACTION!="remove", SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", KERNELS=="0003:05AC:0324.*", MODE="0660", TAG+="uaccess", ENV{ID_SEAT}="seat0"
ACTION!="remove", SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", KERNELS=="0005:004C:0265.*", MODE="0660", TAG+="uaccess", ENV{ID_SEAT}="seat0"
ACTION!="remove", SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", KERNELS=="0005:004C:030E.*", MODE="0660", TAG+="uaccess", ENV{ID_SEAT}="seat0"
ACTION!="remove", SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", KERNELS=="0005:004C:0324.*", MODE="0660", TAG+="uaccess", ENV{ID_SEAT}="seat0"
ACTION!="remove", SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", KERNELS=="0005:05AC:030E.*", MODE="0660", TAG+="uaccess", ENV{ID_SEAT}="seat0"
ACTION!="remove", SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0265", MODE="0660", TAG+="uaccess", ENV{ID_SEAT}="seat0"
ACTION!="remove", SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="030e", MODE="0660", TAG+="uaccess", ENV{ID_SEAT}="seat0"
ACTION!="remove", SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0324", MODE="0660", TAG+="uaccess", ENV{ID_SEAT}="seat0"
EOF
)

usage() {
  cat <<EOF
Usage: trackpad-pack <command>

  apply                         Write Hyprland overlay from saved state (default: all on)
  status                        Print JSON (read-only; does not edit hyprland.lua)
  set <drag3fg|swipe4|macosAccel> <on|off>
  toggle <drag3fg|swipe4|macosAccel>
  battery                       Print HID trackpad battery JSON
  hidraw-status                 Whether the udev rule is present and hidraw is readable
  install-hidraw [--if-needed]  Install the Magic Trackpad udev rule via sudo in a terminal
  uninstall-hidraw              Remove this plugin's udev rule via sudo in a terminal
  uninstall                     Remove this plugin's Hyprland overlay and state files
EOF
}

need_user_helper() {
  [[ -f $PY && ! -L $PY ]] || { echo "missing helper: $PY" >&2; return 1; }
  [[ -x $PYTHON ]] || { echo "missing $PYTHON" >&2; return 1; }
}

run_py() {
  need_user_helper
  local out rc=0
  set +e
  out=$("$TIMEOUT" -k 2 -- 20 "$PYTHON" -I -S "$PY" "$@" | "$HEAD" -c $((MAX_OUT + 1)))
  rc=$?
  set -e
  LC_ALL=C
  if (( ${#out} > MAX_OUT )); then
    echo "helper output exceeded ${MAX_OUT} bytes" >&2
    return 1
  fi
  (( rc == 0 )) || return "$rc"
  printf '%s' "$out"
  [[ $out == *$'\n' ]] || printf '\n'
}

maybe_osd() {
  local json=$1
  local msg
  msg=$(printf '%s' "$json" | "$PYTHON" -I -S -c 'import json,sys; print(json.load(sys.stdin).get("osd") or "")')
  if [[ -n $msg && -x $OSD ]]; then
    "$OSD" -i touchpad -m "$msg" >/dev/null 2>&1 || true
  fi
}

udev_hash() {
  printf '%s' "$UDEV_RULE" | /usr/bin/sha256sum | /usr/bin/cut -d' ' -f1
}

udev_installed() {
  [[ -f $UDEV_DEST && ! -L $UDEV_DEST ]] || return 1
  local have
  have=$(/usr/bin/sha256sum -- "$UDEV_DEST" | /usr/bin/cut -d' ' -f1)
  [[ $have == "$(udev_hash)" ]]
}

require_tty() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "This command needs a terminal so you can confirm the sudo prompt." >&2
    echo "  $0 $1" >&2
    return 2
  fi
}

install_hidraw() {
  local if_needed=0
  [[ ${1:-} == --if-needed ]] && if_needed=1
  case $UDEV_RULE in *\'*|*$'\r'*) echo "refusing udev rule with quote or CR" >&2; return 1 ;; esac
  if udev_installed; then
    echo "already installed $UDEV_DEST"
    return 0
  fi
  if (( if_needed == 1 )) && [[ ! -t 0 || ! -t 1 ]]; then
    echo "hidraw udev rule not installed; run: $0 install-hidraw" >&2
    return 0
  fi
  require_tty install-hidraw
  "$SUDO" /usr/bin/bash -c '
set -euo pipefail
dest=/etc/udev/rules.d/70-xuanping-trackpad-hidraw.rules
old=/etc/udev/rules.d/99-xuanping-trackpad-hidraw.rules
dir=/etc/udev/rules.d
if [[ -L $dir || -L $dest ]]; then
  echo "refusing symlink at udev destination" >&2
  exit 1
fi
[[ -d $dir ]] || { echo "missing $dir" >&2; exit 1; }
tmp=$(/usr/bin/mktemp -p "$dir" .70-xuanping-trackpad-XXXXXX)
trap "rm -f -- \"$tmp\"" EXIT
cat > "$tmp" << "RULE"
'"$UDEV_RULE"'
RULE
/usr/bin/chmod 644 "$tmp"
/usr/bin/mv -f -T -- "$tmp" "$dest"
trap - EXIT
/usr/bin/rm -f -- "$old"
/usr/bin/udevadm control --reload-rules
/usr/bin/udevadm trigger --action=add --subsystem-match=hidraw
'
  echo "installed $UDEV_DEST"
}

uninstall_hidraw() {
  require_tty uninstall-hidraw
  "$SUDO" /usr/bin/bash -c '
set -euo pipefail
dest=/etc/udev/rules.d/70-xuanping-trackpad-hidraw.rules
old=/etc/udev/rules.d/99-xuanping-trackpad-hidraw.rules
if [[ -L $dest || -L $old ]]; then
  echo "refusing to remove a symlink" >&2
  exit 1
fi
/usr/bin/rm -f -- "$dest" "$old"
/usr/bin/udevadm control --reload-rules
/usr/bin/udevadm trigger --action=add --subsystem-match=hidraw
'
  echo "removed $UDEV_DEST"
}

cmd="${1:-}"
case "$cmd" in
  -h | --help | help)
    usage
    ;;
  apply | set | toggle | enable | disable)
    json=$(run_py "$@")
    printf '%s' "$json"
    [[ $json == *$'\n' ]] || printf '\n'
    maybe_osd "$json"
    ;;
  status | battery | notify-get | notify-set | hidraw-status | uninstall)
    run_py "$@"
    ;;
  install-hidraw)
    install_hidraw "${2:-}"
    ;;
  uninstall-hidraw)
    uninstall_hidraw
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
